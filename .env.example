# Copy this file to .env and fill in the real values.
GEMINI_API_KEY=your-gemini-api-key

# Policy RAG uses the hr-policies index and policy_id namespaces.
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_POLICY_INDEX_NAME=hr-policies

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# The original JD-Agent Neo4j node used an embedded connection. The isolated
# backend reads the same connection from these variables instead.
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=
NEO4J_PASSWORD=

CORS_ORIGINS=http://localhost:3000
